# Copy to .env on a NEW install. Keep your existing .env until you migrate it.
# Generate two different long random passwords (e.g. python -c "import secrets; print(secrets.token_hex(24))").
POSTGRES_PASSWORD=replace-with-admin-password
APP_DB_PASSWORD=replace-with-reader-password

# Native Python connection (Compose sets its own private DB hostname and roles).
DB_NAME=floatchat
DB_USER=floatchat_reader
DB_PASS=replace-with-reader-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
# Set only for native ETL; never use writer credentials for the web app.
DB_WRITE_USER=floatchat_admin
DB_WRITE_PASS=replace-with-admin-password

# Open-weight inference. No OpenAI key or OpenAI API is used.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_DAILY_REQUEST_LIMIT=20
AI_HOURLY_CLIENT_LIMIT=5
AI_QUOTA_DB=runtime/ai-quota.sqlite3
OLLAMA_MODEL=qwen3:4b
# Native app default. For Docker Desktop: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Hosted alternative: set AI_PROVIDER=bedrock and AI_ENABLED=true after configuring access.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-32b-v1:0
# Bedrock-only token, not an OpenAI key; protect this file and restrict access in IAM.
AWS_BEARER_TOKEN_BEDROCK=

# Production HTTPS hostname; point DNS A record to your Lightsail static IP.
# No domain? Use <static-ip-with-dashes>.nip.io. On the server, deploy/make-env.sh writes these for you.
DOMAIN=oceans.example.com
# Server only (not local rehearsal): makes plain "docker compose" include the HTTPS proxy override.
# COMPOSE_FILE=compose.yaml:deploy/compose.production.yaml
# Enable only behind a trusted proxy; Compose already enables this with app ports private.
TRUST_PROXY=false
